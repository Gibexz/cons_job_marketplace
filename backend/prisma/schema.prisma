generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  country   String?
  createdAt DateTime @default(now())
  profilePhoto String?

  jobs          Job[]
  workerProfile WorkerProfile?
  company       Company[]
}

// ── NEW: Job lifecycle status ──────────────────────────────
enum JobStatus {
  ACTIVE      // open, accepting applications
  CLOSED      // no longer accepting applications
  COMPLETED   // work has been finished
  CANCELLED   // job was cancelled before completion
  DRAFT       // saved but not yet published
}

model Job {
  id          String    @id @default(uuid())
  title       String
  description String
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  postedById  String
  postedBy    User      @relation(fields: [postedById], references: [id])
  lat         Float?
  lng         Float?
  skills      String[]
  active      Boolean   @default(true)  // kept for backward compat
  status      JobStatus @default(ACTIVE) // ← NEW
  createdAt   DateTime  @default(now())

  applications JobApplication[]
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  PROFESSIONAL
  EXPERT
}

model WorkerProfile {
  id         String          @id @default(uuid())
  userId     String          @unique
  user       User            @relation(fields: [userId], references: [id])
  skills     String[]
  experience ExperienceLevel
  available  Boolean         @default(true)
  bio        String?
  lat        Float?
  lng        Float?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  applications JobApplication[]
}

enum JobApplicationStatus {
  INVITED
  APPLIED
  ACCEPTED
  REJECTED
  COMPLETED
}

model JobApplication {
  id       String               @id @default(uuid())
  jobId    String
  workerId String
  status   JobApplicationStatus @default(INVITED)

  job    Job           @relation(fields: [jobId], references: [id])
  worker WorkerProfile @relation(fields: [workerId], references: [id])

  createdAt DateTime @default(now())

  @@unique([jobId, workerId])
}

model Company {
  id        String   @id @default(uuid())
  name      String
  logo      String?
  address   String?
  rating    Float    @default(0)
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  jobs      Job[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}